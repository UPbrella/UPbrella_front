{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "vite.config.ts"] },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100, "lineEnding": "auto" },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "rules": {
      "recommended": true,
      "a11y": "warn",
      "style": { "useImportType": "off" },
      "suspicious": {
        "noConsole": "error",
        "noShadowRestrictedNames": "warn",
        "useIterableCallbackReturn": "warn",
        "noArrayIndexKey": "warn"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "warn",
        "useJsxKeyInIterable": "warn",
        "noChildrenProp": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "warn",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/**",
                      "@/pages/**",
                      "@/widgets/**",
                      "@/features/**",
                      "@/entities/**"
                    ],
                    "message": "shared는 상위 계층을 import할 수 없습니다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/entities/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "warn",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/pages/**", "@/widgets/**", "@/features/**"],
                    "message": "entities는 상위 계층을 import할 수 없습니다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "warn",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/pages/**", "@/widgets/**"],
                    "message": "features는 상위 계층을 import할 수 없습니다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/widgets/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "warn",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/pages/**"],
                    "message": "widgets는 상위 계층을 import할 수 없습니다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/pages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "warn",
              "options": {
                "patterns": [
                  { "group": ["@/app/**"], "message": "pages는 app을 import할 수 없습니다." }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
