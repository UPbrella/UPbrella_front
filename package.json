{
  "name": "upbrella-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "start": "vite --open --host 0.0.0.0 --port 3000",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "biome lint ./src",
    "preview": "vite preview",
    "format": "biome format --write .",
    "check": "biome check ./src",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "type-check": "tsc --noEmit",
    "i18n:generate": "tsx scripts/generate-i18n.ts"
  },
  "dependencies": {
    "@emailjs/browser": "^3.12.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@sentry/react": "^11.6.0",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "file-saver": "^2.0.5",
    "i18next": "^26.4.2",
    "primeicons": "^6.0.1",
    "primereact": "^10.9.9",
    "qrcode.react": "^4.2.0",
    "qs": "^6.16.0",
    "react": "^19.3.0",
    "react-daum-postcode": "^4.0.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.89.0",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^17.0.16",
    "react-modal-sheet": "^2.2.1",
    "react-router-dom": "^6.30.6",
    "supercluster": "^8.0.1",
    "swiper": "^12.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@sentry/vite-plugin": "^5.4.1",
    "@types/file-saver": "^2.0.7",
    "@types/navermaps": "^3.9.2",
    "@types/node": "^22.20.5",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-build": "7.4.1",
    "workbox-window": "^7.4.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "pnpm": {
    "overrides": {
      "react-modal-sheet>@react-aria/utils": "^3.25.0"
    }
  }
}
